# Veri kaynakları için API anahtarı veya ücretli abonelik gerekmez.
# TurkiyeAPI, resmî nöbet kaynakları ve OpenStreetMap kullanılır.

# Eczaneler.org lisanslı nöbetçi eczane API anahtarı (yalnızca sunucuda; tarayıcıya gönderilmez).
# İsteğe bağlı: tanımlıysa önce bu kaynak denenir; tanımlı değilse ücretsiz resmî oda sayfaları ve bağlantılar kullanılır.
ECZANELER_API_KEY=

# EczaneAPI (eczaneapi.com) ücretsiz plan anahtarı (yalnızca sunucuda). Tanımlıysa resmî kaynağı kapalı
# olan illerde (İstanbul, Yalova, Amasya, Ordu) kullanılır. Her il günde en fazla bir kez istenir.
ECZANEAPI_KEY=
# İsteğe bağlı: EczaneAPI'nin kullanılacağı iller (virgülle). Boşsa yukarıdaki dört il.
ECZANEAPI_PROVINCES=
